# WPI Local Development Environment
# Copy this file to .env.local and fill in the real values.

# Audit pipeline
WPI_DISPATCH_MODE=stub
DATABASE_URL=
COOKIE_SECRET=

# OAuth token encryption (32 bytes as 64 hex characters)
ENCRYPTION_KEY=

# Google OAuth (fill in after creating Google Cloud project)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# App URL (used for OAuth callback redirect and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend for production; leave RESEND_API_KEY blank to use the stub adapter locally)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com
