{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:architecture-plan:0.1.0",
  "title": "ArchitecturePlan",
  "description": "A page map, hierarchy, navigation model, URL policy and internal-link plan built from business goals, existing URLs, demand, page ownership and approved SERP-overlap evidence. It cannot change URLs; URL changes become migration proposals.",
  "type": "object",
  "required": [
    "plan_id",
    "project_id",
    "business_goals",
    "inputs",
    "url_policy",
    "url_changes_proposed",
    "status",
    "created_at",
    "lineage"
  ],
  "properties": {
    "plan_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "site_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "business_goals": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/text"
      },
      "minItems": 1,
      "maxItems": 20
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref_ids"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "existing_urls",
              "demand",
              "intent",
              "page_ownership",
              "serp_overlap"
            ]
          },
          "ref_ids": {
            "$ref": "common.schema.json#/$defs/uuid_list"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20
    },
    "url_policy": {
      "type": "object",
      "required": [
        "language_segment",
        "arabic_slug_policy",
        "trailing_slash",
        "notes"
      ],
      "properties": {
        "language_segment": {
          "type": "string",
          "enum": [
            "path_prefix",
            "subdomain",
            "cctld",
            "none"
          ]
        },
        "arabic_slug_policy": {
          "type": "string",
          "enum": [
            "arabic_script",
            "transliterated",
            "english",
            "mixed_existing"
          ]
        },
        "trailing_slash": {
          "type": "string",
          "enum": [
            "always",
            "never",
            "existing"
          ]
        },
        "notes": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "navigation_notes": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/long_text"
        },
        {
          "type": "null"
        }
      ]
    },
    "url_changes_proposed": {
      "type": "boolean"
    },
    "migration_baseline_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid",
          "description": "Required when URL changes are proposed."
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "superseded"
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage",
      "description": "Lineage for the values in this record (03-PRODUCTION-CONTRACTS: Evidence and fidelity)."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "url_changes_proposed": {
            "const": true
          }
        },
        "required": [
          "url_changes_proposed"
        ]
      },
      "then": {
        "properties": {
          "migration_baseline_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        }
      }
    }
  ],
  "x-version": "0.1.0",
  "x-status": "draft",
  "x-source": [
    "03-PRODUCTION-CONTRACTS: Minimum schema set",
    "04-CLAUDE-CODE-BUILD-PROMPT §25",
    "01-PRODUCT-REQUIREMENTS §17",
    "05-PROJECT-PLAN M8C"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md"
}
