{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:programmatic-template:0.1.0",
  "title": "ProgrammaticTemplate",
  "description": "A programmatic page template with its dataset and gate results. Generation is blocked until every gate passes.",
  "type": "object",
  "required": [
    "template_id",
    "project_id",
    "name",
    "page_type",
    "dataset",
    "unique_value_statement",
    "required_fields",
    "indexability_rule",
    "gate_results",
    "status"
  ],
  "properties": {
    "template_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/label"
    },
    "page_type": {
      "$ref": "common.schema.json#/$defs/label"
    },
    "dataset": {
      "type": "object",
      "required": [
        "name",
        "owner",
        "source_url",
        "authoritative",
        "stable_id_field"
      ],
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/label"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/label"
        },
        "source_url": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/url"
            },
            {
              "type": "null"
            }
          ]
        },
        "authoritative": {
          "type": "boolean"
        },
        "stable_id_field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "unique_value_statement": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "required_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "indexability_rule": {
      "type": "string",
      "enum": [
        "index_when_complete",
        "noindex_until_reviewed",
        "noindex"
      ]
    },
    "gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate",
          "outcome",
          "evidence_ids"
        ],
        "properties": {
          "gate": {
            "type": "string",
            "enum": [
              "source_ownership",
              "record_completeness",
              "unique_value",
              "stable_identifiers",
              "template_tests",
              "similarity_check",
              "batch_approval",
              "monitoring"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "pending"
            ]
          },
          "evidence_ids": {
            "$ref": "common.schema.json#/$defs/evidence_ids"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 8
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "gate_blocked",
        "approved_for_canary",
        "active",
        "paused",
        "retired"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved_for_canary",
              "active"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "gate_results": {
            "minItems": 8,
            "items": {
              "properties": {
                "outcome": {
                  "const": "pass"
                }
              }
            }
          }
        }
      }
    }
  ],
  "x-version": "0.1.0",
  "x-status": "draft",
  "x-source": [
    "03-PRODUCTION-CONTRACTS: Minimum schema set",
    "01-PRODUCT-REQUIREMENTS §17",
    "04-CLAUDE-CODE-BUILD-PROMPT §25"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md"
}
