{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:citation:0.1.0",
  "title": "Citation",
  "description": "One URL cited or considered in a provider answer, normalized and classified. Positions are recorded only when the provider returns them (v1-baseline §8.6).",
  "type": "object",
  "required": [
    "citation_id",
    "prompt_run_id",
    "url",
    "registrable_domain",
    "owner_class",
    "position",
    "in_final_answer",
    "lineage"
  ],
  "properties": {
    "citation_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "prompt_run_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "url": {
      "$ref": "common.schema.json#/$defs/url",
      "description": "Normalized URL."
    },
    "url_as_returned": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "registrable_domain": {
      "$ref": "common.schema.json#/$defs/hostname"
    },
    "owner_class": {
      "type": "string",
      "enum": [
        "owned",
        "competitor",
        "third_party",
        "unknown"
      ]
    },
    "position": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        {
          "type": "null"
        }
      ],
      "description": "Null when the provider does not return a position."
    },
    "in_final_answer": {
      "type": "boolean",
      "description": "False when the API exposes the source only as considered, not cited."
    },
    "fetched_evidence_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Evidence from fetching the cited page for lost-prompt analysis."
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage",
      "description": "Lineage for the values in this record (03-PRODUCTION-CONTRACTS: Evidence and fidelity)."
    }
  },
  "additionalProperties": false,
  "x-version": "0.1.0",
  "x-status": "proposed",
  "x-source": [
    "v1-baseline §8.6",
    "03-PRODUCTION-CONTRACTS: Minimum schema set"
  ],
  "x-source-fields": [
    "url",
    "registrable_domain",
    "owner_class",
    "prompt_run_id",
    "in_final_answer",
    "position"
  ],
  "x-added-fields": [
    "citation_id",
    "url_as_returned",
    "fetched_evidence_id",
    "lineage"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md"
}
