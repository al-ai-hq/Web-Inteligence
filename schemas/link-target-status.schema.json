{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:link-target-status:0.1.0",
  "title": "LinkTargetStatus",
  "description": "Live status of a linked page on the owned site, for broken or lost link reclamation.",
  "type": "object",
  "required": [
    "status_id",
    "project_id",
    "target_url",
    "http_status",
    "outcome",
    "reclamation_candidate",
    "checked_at",
    "evidence_id",
    "lineage"
  ],
  "properties": {
    "status_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "target_url": {
      "$ref": "common.schema.json#/$defs/url"
    },
    "http_status": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        {
          "type": "null"
        }
      ]
    },
    "final_url": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/url"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "broken_4xx",
        "error_5xx",
        "redirected",
        "redirect_chain",
        "blocked",
        "unreachable"
      ]
    },
    "referring_domains_reported": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ],
      "description": "As reported by the named export; never summed across sources."
    },
    "reported_by_source": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "search_console_export",
            "bing_webmaster_export",
            "licensed_tool_export"
          ],
          "description": "Dated export source. Sources and indexes are never combined into one total."
        },
        {
          "type": "null"
        }
      ]
    },
    "reclamation_candidate": {
      "type": "boolean"
    },
    "checked_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "evidence_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage",
      "description": "Lineage for the values in this record (03-PRODUCTION-CONTRACTS: Evidence and fidelity)."
    }
  },
  "additionalProperties": false,
  "x-version": "0.1.0",
  "x-status": "draft",
  "x-source": [
    "03-PRODUCTION-CONTRACTS: Minimum schema set",
    "01-PRODUCT-REQUIREMENTS §17",
    "05-PROJECT-PLAN M8C"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md"
}
