{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:performance-observation:0.1.0",
  "title": "PerformanceObservation",
  "description": "One source-specific metric value for one period and dimension set. Sources stay separate: Search Console clicks, GA4 sessions, provider observations and business outcomes are never added together.",
  "type": "object",
  "required": [
    "observation_id",
    "project_id",
    "source",
    "metric",
    "value",
    "unit",
    "numerator",
    "denominator",
    "date_range",
    "date_timezone",
    "dimensions",
    "integrity_state",
    "incomplete_period",
    "lineage"
  ],
  "properties": {
    "observation_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "site_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "search_console",
        "search_console_generative_ai_export",
        "ga4",
        "pagespeed",
        "crux"
      ]
    },
    "metric": {
      "type": "string",
      "enum": [
        "clicks",
        "impressions",
        "ctr",
        "avg_position",
        "sessions",
        "engaged_sessions",
        "key_events",
        "ai_assistant_referral_sessions",
        "generative_ai_impressions",
        "lcp_p75_ms",
        "inp_p75_ms",
        "cls_p75"
      ]
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null when unavailable. A measured zero is 0 with integrity_state measured_zero."
    },
    "unit": {
      "type": "string",
      "enum": [
        "count",
        "ratio",
        "position",
        "milliseconds",
        "unitless"
      ]
    },
    "numerator": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "denominator": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "date_range": {
      "$ref": "common.schema.json#/$defs/date_range"
    },
    "date_timezone": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$"
    },
    "dimensions": {
      "type": "object",
      "required": [],
      "properties": {
        "page": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/url"
            },
            {
              "type": "null"
            }
          ]
        },
        "query": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "cluster_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "market": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/market"
            },
            {
              "type": "null"
            }
          ]
        },
        "device": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/device"
            },
            {
              "type": "null"
            }
          ]
        },
        "search_appearance": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/label"
            },
            {
              "type": "null"
            }
          ]
        },
        "brand_segment": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "brand",
                "non_brand"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "integrity_state": {
      "$ref": "common.schema.json#/$defs/integrity_state"
    },
    "incomplete_period": {
      "type": "boolean",
      "description": "True when the period includes the latest 2-3 days of Search Console data."
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage",
      "description": "Lineage for the values in this record (03-PRODUCTION-CONTRACTS: Evidence and fidelity)."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "metric": {
            "const": "ctr"
          }
        },
        "required": [
          "metric"
        ]
      },
      "then": {
        "properties": {
          "numerator": {
            "type": "number",
            "minimum": 0
          },
          "denominator": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "search_console_generative_ai_export"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "metric": {
            "const": "generative_ai_impressions"
          }
        }
      }
    }
  ],
  "x-version": "0.1.0",
  "x-status": "draft",
  "x-source": [
    "03-PRODUCTION-CONTRACTS: Minimum schema set",
    "02-DETAILED-SPECIFICATION §7, §15",
    "01-PRODUCT-REQUIREMENTS §5.7, §8"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md"
}
