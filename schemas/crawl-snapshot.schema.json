{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:crawl-snapshot:0.1.0",
  "title": "CrawlSnapshot",
  "description": "An immutable, versioned crawl baseline or post-change capture of a fixed critical-URL set.",
  "type": "object",
  "required": [
    "snapshot_id",
    "project_id",
    "kind",
    "critical_urls",
    "captured_at",
    "crawler_version",
    "methodology_version",
    "coverage",
    "storage_uri",
    "immutable",
    "content_hash",
    "lineage"
  ],
  "properties": {
    "snapshot_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "site_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "known_good_baseline",
        "post_change",
        "scheduled"
      ]
    },
    "critical_urls": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/url"
      },
      "minItems": 1,
      "maxItems": 2000,
      "uniqueItems": true
    },
    "captured_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "release_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "crawler_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "methodology_version": {
      "$ref": "common.schema.json#/$defs/methodology_version"
    },
    "coverage": {
      "$ref": "common.schema.json#/$defs/checked_of"
    },
    "storage_uri": {
      "$ref": "common.schema.json#/$defs/storage_uri"
    },
    "immutable": {
      "const": true
    },
    "content_hash": {
      "$ref": "common.schema.json#/$defs/content_hash"
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage",
      "description": "Lineage for the values in this record (03-PRODUCTION-CONTRACTS: Evidence and fidelity)."
    }
  },
  "additionalProperties": false,
  "x-version": "0.1.0",
  "x-status": "draft",
  "x-source": [
    "03-PRODUCTION-CONTRACTS: Minimum schema set",
    "01-PRODUCT-REQUIREMENTS §17",
    "04-CLAUDE-CODE-BUILD-PROMPT §25",
    "05-PROJECT-PLAN M8C"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md"
}
