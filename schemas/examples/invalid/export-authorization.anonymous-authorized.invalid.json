{
  "description": "D-002: an anonymous export request can never be authorized.",
  "base_example": "export-authorization.example.json",
  "patch": [
    {
      "op": "replace",
      "path": "/decision",
      "value": "authorized"
    },
    {
      "op": "replace",
      "path": "/denial_reason",
      "value": null
    },
    {
      "op": "replace",
      "path": "/state",
      "value": "AUTHORIZED"
    }
  ]
}
