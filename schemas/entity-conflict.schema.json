{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:entity-conflict:0.1.0",
  "title": "EntityConflict",
  "description": "Two or more sources disagree about an entity attribute. Never auto-resolved: a named human resolves it (02-DETAILED-SPECIFICATION §15).",
  "type": "object",
  "required": [
    "conflict_id",
    "project_id",
    "attribute",
    "values",
    "status",
    "detected_at",
    "lineage"
  ],
  "properties": {
    "conflict_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "fact_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "attribute": {
      "type": "string",
      "enum": [
        "name",
        "address",
        "phone",
        "hours",
        "category",
        "price",
        "availability",
        "url",
        "founder",
        "service_area",
        "other"
      ]
    },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "source_url",
          "value",
          "evidence_id",
          "captured_at"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "fact_register",
              "owned_site",
              "business_profile",
              "merchant_center",
              "directory",
              "social_profile",
              "ai_answer",
              "third_party"
            ]
          },
          "source_url": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/url"
              },
              {
                "type": "null"
              }
            ]
          },
          "value": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "evidence_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "captured_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          }
        },
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 20
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "owner_confirmed_value",
        "correction_requested",
        "resolved",
        "dismissed"
      ]
    },
    "resolved_by_user_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "resolution_note": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "detected_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage",
      "description": "Lineage for the values in this record (03-PRODUCTION-CONTRACTS: Evidence and fidelity)."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "resolved",
              "owner_confirmed_value",
              "dismissed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "resolved_by_user_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        }
      }
    }
  ],
  "x-version": "0.1.0",
  "x-status": "draft",
  "x-source": [
    "03-PRODUCTION-CONTRACTS: Minimum schema set",
    "02-DETAILED-SPECIFICATION §15",
    "01-PRODUCT-REQUIREMENTS §16"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md"
}
