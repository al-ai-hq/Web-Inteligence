{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:regression-decision:0.1.0",
  "title": "RegressionDecision",
  "description": "The final decision on a diff: intended, confirmed regression or unknown. A confirmed regression needs a named human and live evidence, and links to release evidence and rollback.",
  "type": "object",
  "required": [
    "decision_id",
    "diff_id",
    "review_ids",
    "decision",
    "decided_at"
  ],
  "properties": {
    "decision_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "diff_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "review_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "decision": {
      "type": "string",
      "enum": [
        "intended",
        "regression_confirmed",
        "unknown"
      ]
    },
    "confirmed_by_user_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "live_evidence_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "release_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "rollback_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "change_set_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "decided_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "regression_confirmed"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "confirmed_by_user_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "live_evidence_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        }
      }
    }
  ],
  "x-version": "0.1.0",
  "x-status": "draft",
  "x-source": [
    "03-PRODUCTION-CONTRACTS: Minimum schema set",
    "01-PRODUCT-REQUIREMENTS §17",
    "04-CLAUDE-CODE-BUILD-PROMPT §25",
    "05-PROJECT-PLAN M8C"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md"
}
