{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:rule-result:0.1.0",
  "title": "RuleResult",
  "description": "The result of one rule on one page, template or site. Scores are recomputed from stored rule results.",
  "type": "object",
  "required": [
    "rule_result_id",
    "audit_id",
    "rule_id",
    "methodology_version",
    "result",
    "method",
    "scope",
    "affected_urls",
    "evidence_ids",
    "confidence",
    "evaluated_at",
    "lineage"
  ],
  "properties": {
    "rule_result_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "audit_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "rule_id": {
      "$ref": "common.schema.json#/$defs/rule_id"
    },
    "methodology_version": {
      "$ref": "common.schema.json#/$defs/methodology_version"
    },
    "result": {
      "$ref": "common.schema.json#/$defs/rule_result"
    },
    "method": {
      "$ref": "common.schema.json#/$defs/evaluation_method"
    },
    "scope": {
      "type": "string",
      "enum": [
        "page",
        "template",
        "site"
      ]
    },
    "page_url": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/url"
        },
        {
          "type": "null"
        }
      ]
    },
    "affected_urls": {
      "$ref": "common.schema.json#/$defs/url_list"
    },
    "evidence_ids": {
      "$ref": "common.schema.json#/$defs/evidence_ids"
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "One-sentence rationale for assessed results."
        },
        {
          "type": "null"
        }
      ]
    },
    "quoted_spans": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/quoted_span"
      },
      "minItems": 0,
      "maxItems": 10
    },
    "confidence": {
      "$ref": "common.schema.json#/$defs/confidence_level"
    },
    "reviewer_user_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Reviewer trace for assessed or attested results."
    },
    "evaluated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage",
      "description": "Lineage for the values in this record (03-PRODUCTION-CONTRACTS: Evidence and fidelity)."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "enum": [
              "pass",
              "partial",
              "fail"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "x-version": "0.1.0",
  "x-status": "draft",
  "x-source": [
    "03-PRODUCTION-CONTRACTS: Minimum schema set",
    "v1-baseline §6.3, §7",
    "04-CLAUDE-CODE-BUILD-PROMPT Appendix A (runtime agent instructions) (AUDITOR)"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md"
}
