{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:roadmap:0.1.0",
  "title": "Roadmap",
  "description": "The executive action board (at most 12 items; 8-12 when enough evidence-backed items exist, never padded) and the 30/60/90-day roadmap. Anonymous roadmaps are preliminary.",
  "type": "object",
  "required": [
    "roadmap_id",
    "audit_id",
    "board",
    "horizons",
    "preliminary",
    "methodology_version",
    "created_at",
    "lineage"
  ],
  "properties": {
    "roadmap_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "audit_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "board": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      },
      "minItems": 0,
      "maxItems": 12,
      "uniqueItems": true,
      "description": "PlanItem IDs in board order."
    },
    "horizons": {
      "type": "object",
      "required": [
        "0-30",
        "31-60",
        "61-90"
      ],
      "properties": {
        "0-30": {
          "$ref": "common.schema.json#/$defs/uuid_list"
        },
        "31-60": {
          "$ref": "common.schema.json#/$defs/uuid_list"
        },
        "61-90": {
          "$ref": "common.schema.json#/$defs/uuid_list"
        }
      },
      "additionalProperties": false
    },
    "preliminary": {
      "type": "boolean"
    },
    "methodology_version": {
      "$ref": "common.schema.json#/$defs/methodology_version"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage",
      "description": "Lineage for the values in this record (03-PRODUCTION-CONTRACTS: Evidence and fidelity)."
    }
  },
  "additionalProperties": false,
  "x-version": "0.1.0",
  "x-status": "draft",
  "x-source": [
    "03-PRODUCTION-CONTRACTS: Minimum schema set",
    "04-CLAUDE-CODE-BUILD-PROMPT §3.1, §14",
    "02-DETAILED-SPECIFICATION §8"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md"
}
