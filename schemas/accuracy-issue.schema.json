{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:accuracy-issue:0.1.0",
  "title": "AccuracyIssue",
  "description": "A wrong or outdated statement about the brand in a provider answer, tied to the exact run and the confirmed fact it contradicts. Legal, defamation, trademark, fraud, disputed and Wikipedia/Wikidata cases escalate to a named human.",
  "type": "object",
  "required": [
    "issue_id",
    "prompt_run_id",
    "fact_id",
    "quoted_statement",
    "issue_type",
    "severity",
    "status",
    "escalation",
    "detected_at",
    "lineage"
  ],
  "properties": {
    "issue_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "prompt_run_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "fact_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "FactRegister fact the statement contradicts."
    },
    "quoted_statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "issue_type": {
      "type": "string",
      "enum": [
        "price",
        "availability",
        "location",
        "service",
        "ownership",
        "founder",
        "policy",
        "contact",
        "hours",
        "claim",
        "other"
      ]
    },
    "severity": {
      "$ref": "common.schema.json#/$defs/severity"
    },
    "cited_citation_ids": {
      "$ref": "common.schema.json#/$defs/uuid_list"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "correction_planned",
        "owned_source_corrected",
        "third_party_request_sent",
        "recheck_resolved",
        "recheck_persisting",
        "escalated",
        "dismissed"
      ]
    },
    "escalation": {
      "type": "object",
      "required": [
        "required",
        "reason",
        "owner_user_id"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "legal",
                "defamation",
                "trademark",
                "fraud",
                "disputed_claim",
                "wikipedia_wikidata"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_user_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "detected_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage",
      "description": "Lineage for the values in this record (03-PRODUCTION-CONTRACTS: Evidence and fidelity)."
    }
  },
  "additionalProperties": false,
  "x-version": "0.1.0",
  "x-status": "proposed",
  "x-source": [
    "04-CLAUDE-CODE-BUILD-PROMPT Appendix A (runtime agent instructions) (VISIBILITY TESTER accuracy_issues)",
    "01-PRODUCT-REQUIREMENTS §16",
    "03-PRODUCTION-CONTRACTS: Minimum schema set"
  ],
  "x-source-fields": [
    "quoted_statement",
    "fact_id"
  ],
  "x-added-fields": [
    "issue_id",
    "prompt_run_id",
    "issue_type",
    "severity",
    "cited_citation_ids",
    "status",
    "escalation",
    "detected_at",
    "lineage"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md"
}
