{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:change-set:0.1.0",
  "title": "ChangeSet",
  "description": "A set of field-level changes for one site and connector, moving through the V4 change states. The connector refuses any change set without the required approvals and a stored snapshot. Tier 3 needs two approvers and the requester cannot approve (checked in code).",
  "type": "object",
  "required": [
    "change_set_id",
    "project_id",
    "site_id",
    "connector",
    "environment",
    "operations",
    "requested_by_user_id",
    "approvals",
    "required_approvals",
    "max_risk_tier",
    "mode",
    "snapshot_id",
    "status",
    "auto_rollback_authorized",
    "idempotency_key",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "change_set_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "Build prompt field workspace_id maps to project_id until M11 (D-004)."
    },
    "site_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "connector": {
      "$ref": "common.schema.json#/$defs/config_key"
    },
    "environment": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/environment"
        },
        {
          "enum": [
            "staging",
            "production"
          ]
        }
      ]
    },
    "plan_item_ids": {
      "$ref": "common.schema.json#/$defs/uuid_list"
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "change-operation.schema.json"
      },
      "minItems": 1,
      "maxItems": 200
    },
    "requested_by_user_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "approval_id",
          "user_id",
          "at"
        ],
        "properties": {
          "approval_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "user_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 2
    },
    "required_approvals": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "max_risk_tier": {
      "$ref": "common.schema.json#/$defs/plan_risk_tier"
    },
    "mode": {
      "type": "string",
      "enum": [
        "edit_only",
        "edit_then_publish"
      ],
      "description": "Publish is a separate permission with its own Approval."
    },
    "publish_approval_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "canary_op_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      },
      "minItems": 0,
      "maxItems": 2,
      "uniqueItems": true,
      "description": "Tier 1 canary of 1-2 pages, read back before the rest."
    },
    "batch_size_max": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 25,
          "description": "Tier 1 batch limit. ASSUMPTION 25 pages (02-DETAILED-SPECIFICATION §10)."
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval_expires_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "common.schema.json#/$defs/change_state"
    },
    "status_reason_key": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/message_key"
        },
        {
          "type": "null"
        }
      ]
    },
    "auto_rollback_authorized": {
      "type": "boolean",
      "description": "Automatic rollback only when the approval explicitly authorizes it (01-PRODUCT-REQUIREMENTS §15)."
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "max_risk_tier": {
            "const": 3
          }
        },
        "required": [
          "max_risk_tier"
        ]
      },
      "then": {
        "properties": {
          "required_approvals": {
            "const": 2
          },
          "batch_size_max": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "APPROVED",
              "SNAPSHOTTING",
              "APPLYING_CANARY",
              "VERIFYING_CANARY",
              "APPLYING",
              "READ_BACK",
              "PUBLIC_VALIDATION",
              "VERIFIED",
              "MISMATCH",
              "PARTIAL",
              "ROLLBACK_REQUESTED",
              "ROLLED_BACK"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approvals": {
            "minItems": 1
          },
          "approval_expires_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "APPROVED",
              "SNAPSHOTTING",
              "APPLYING_CANARY",
              "VERIFYING_CANARY",
              "APPLYING",
              "READ_BACK",
              "PUBLIC_VALIDATION",
              "VERIFIED",
              "MISMATCH",
              "PARTIAL",
              "ROLLBACK_REQUESTED",
              "ROLLED_BACK"
            ]
          },
          "max_risk_tier": {
            "const": 3
          }
        },
        "required": [
          "status",
          "max_risk_tier"
        ]
      },
      "then": {
        "properties": {
          "approvals": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "APPLYING_CANARY",
              "VERIFYING_CANARY",
              "APPLYING",
              "READ_BACK",
              "PUBLIC_VALIDATION",
              "VERIFIED",
              "MISMATCH",
              "PARTIAL",
              "ROLLBACK_REQUESTED",
              "ROLLED_BACK"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "snapshot_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "edit_then_publish"
          },
          "status": {
            "enum": [
              "APPROVED",
              "SNAPSHOTTING",
              "APPLYING_CANARY",
              "VERIFYING_CANARY",
              "APPLYING",
              "READ_BACK",
              "PUBLIC_VALIDATION",
              "VERIFIED",
              "MISMATCH",
              "PARTIAL",
              "ROLLBACK_REQUESTED",
              "ROLLED_BACK"
            ]
          }
        },
        "required": [
          "mode",
          "status"
        ]
      },
      "then": {
        "properties": {
          "publish_approval_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        }
      }
    }
  ],
  "x-version": "0.1.0",
  "x-status": "proposed",
  "x-source": [
    "04-CLAUDE-CODE-BUILD-PROMPT Appendix B (data contracts)",
    "03-PRODUCTION-CONTRACTS: Workflow states",
    "03-PRODUCTION-CONTRACTS: Change risk baseline",
    "02-DETAILED-SPECIFICATION §10"
  ],
  "x-source-fields": [
    "change_set_id",
    "project_id",
    "connector",
    "operations",
    "requested_by_user_id",
    "approvals",
    "required_approvals",
    "snapshot_id",
    "status"
  ],
  "x-added-fields": [
    "site_id",
    "environment",
    "plan_item_ids",
    "max_risk_tier",
    "mode",
    "publish_approval_id",
    "canary_op_ids",
    "batch_size_max",
    "approval_expires_at",
    "status_reason_key",
    "auto_rollback_authorized",
    "idempotency_key",
    "created_at",
    "updated_at"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md",
  "x-field-mapping": {
    "workspace_id": "project_id",
    "requested_by": "requested_by_user_id"
  },
  "x-conflicts": [
    "status uses the V4 change states (03-PRODUCTION-CONTRACTS), not the build prompt's lower-case list (draft, validated, previewed, approved, applying, applied, verified, mismatch, rolled_back, rejected)."
  ]
}
