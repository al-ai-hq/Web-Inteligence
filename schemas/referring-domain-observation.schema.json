{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:referring-domain-observation:0.1.0",
  "title": "ReferringDomainObservation",
  "description": "One referring domain from one dated export. Counts are as reported by that source.",
  "type": "object",
  "required": [
    "observation_id",
    "project_id",
    "source",
    "source_name",
    "export_date",
    "domain",
    "lineage"
  ],
  "properties": {
    "observation_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "source": {
      "type": "string",
      "enum": [
        "search_console_export",
        "bing_webmaster_export",
        "licensed_tool_export"
      ],
      "description": "Dated export source. Sources and indexes are never combined into one total."
    },
    "source_name": {
      "$ref": "common.schema.json#/$defs/label"
    },
    "export_date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "domain": {
      "$ref": "common.schema.json#/$defs/hostname"
    },
    "backlinks_reported": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "first_seen": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "vendor_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "vendor"
        ],
        "properties": {
          "name": {
            "$ref": "common.schema.json#/$defs/label"
          },
          "value": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "number"
                ],
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "vendor": {
            "$ref": "common.schema.json#/$defs/label"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 20,
      "description": "Vendor-specific metrics, labelled as such. Never presented as Google metrics or combined into a synthetic score."
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage",
      "description": "Lineage for the values in this record (03-PRODUCTION-CONTRACTS: Evidence and fidelity)."
    }
  },
  "additionalProperties": false,
  "x-version": "0.1.0",
  "x-status": "draft",
  "x-source": [
    "03-PRODUCTION-CONTRACTS: Minimum schema set",
    "01-PRODUCT-REQUIREMENTS §17"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md"
}
