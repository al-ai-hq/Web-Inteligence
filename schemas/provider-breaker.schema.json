{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:provider-breaker:0.1.0",
  "title": "ProviderBreaker",
  "description": "Circuit-breaker state for one provider. An open breaker marks that provider's results unavailable, never 0%, and the audit continues.",
  "type": "object",
  "required": [
    "breaker_id",
    "provider",
    "state",
    "consecutive_failures",
    "failure_threshold",
    "cooldown_seconds",
    "opened_at",
    "next_probe_at",
    "updated_at"
  ],
  "properties": {
    "breaker_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "provider": {
      "$ref": "common.schema.json#/$defs/config_key"
    },
    "state": {
      "type": "string",
      "enum": [
        "closed",
        "open",
        "half_open"
      ]
    },
    "consecutive_failures": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "failure_threshold": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "ASSUMPTION (D-007): 3 consecutive timeouts or 5xx. Read from config."
    },
    "cooldown_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400,
      "description": "ASSUMPTION (D-007): 900 seconds. Read from config."
    },
    "opened_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_probe_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_error_class": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/error_class"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "open"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "opened_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "next_probe_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "closed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "opened_at": {
            "type": "null"
          },
          "next_probe_at": {
            "type": "null"
          }
        }
      }
    }
  ],
  "x-version": "0.1.0",
  "x-status": "proposed",
  "x-source": [
    "02-DETAILED-SPECIFICATION §18",
    "D-007",
    "03-PRODUCTION-CONTRACTS: Minimum schema set"
  ],
  "x-source-fields": [
    "provider",
    "state",
    "consecutive_failures",
    "failure_threshold",
    "cooldown_seconds",
    "next_probe_at"
  ],
  "x-added-fields": [
    "breaker_id",
    "opened_at",
    "last_error_class",
    "updated_at"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md"
}
