{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:similarity-observation:0.1.0",
  "title": "SimilarityObservation",
  "description": "Similarity between two generated pages or records. The threshold is configuration, not a universal rule.",
  "type": "object",
  "required": [
    "observation_id",
    "template_id",
    "item_a",
    "item_b",
    "method",
    "score",
    "threshold_config_key",
    "flagged",
    "lineage"
  ],
  "properties": {
    "observation_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "template_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "batch_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "item_a": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "ProgrammaticRecord ID."
    },
    "item_b": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "ProgrammaticRecord ID."
    },
    "method": {
      "type": "string",
      "enum": [
        "shingle_jaccard",
        "embedding_cosine",
        "content_hash_equal"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "threshold_config_key": {
      "$ref": "common.schema.json#/$defs/config_key"
    },
    "flagged": {
      "type": "boolean"
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage",
      "description": "Lineage for the values in this record (03-PRODUCTION-CONTRACTS: Evidence and fidelity)."
    }
  },
  "additionalProperties": false,
  "x-version": "0.1.0",
  "x-status": "draft",
  "x-source": [
    "03-PRODUCTION-CONTRACTS: Minimum schema set",
    "01-PRODUCT-REQUIREMENTS §17"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md"
}
