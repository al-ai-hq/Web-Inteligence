{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:migration-baseline:0.1.0",
  "title": "MigrationBaseline",
  "description": "A dated baseline captured before a migration. Every URL change enters migration control; no launch action is automatic and no lossless migration is promised.",
  "type": "object",
  "required": [
    "baseline_id",
    "project_id",
    "migration_type",
    "captured_at",
    "crawl_snapshot_id",
    "url_count",
    "tracked_elements",
    "owners",
    "status",
    "lineage"
  ],
  "properties": {
    "baseline_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "migration_type": {
      "type": "string",
      "enum": [
        "domain",
        "host_cdn",
        "https",
        "url_structure",
        "cms_platform",
        "redesign",
        "language_market",
        "merger",
        "cctld"
      ]
    },
    "captured_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "crawl_snapshot_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "url_count": {
      "type": "integer",
      "minimum": 0
    },
    "search_console_period": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/date_range"
        },
        {
          "type": "null"
        }
      ]
    },
    "analytics_period": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/date_range"
        },
        {
          "type": "null"
        }
      ]
    },
    "tracked_elements": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "hreflang",
          "canonicals",
          "structured_data_ids",
          "feeds",
          "analytics",
          "consent",
          "listings",
          "bot_behavior",
          "sitemaps",
          "robots",
          "arabic_url_encoding"
        ]
      },
      "minItems": 1,
      "maxItems": 11,
      "uniqueItems": true
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "user_id"
        ],
        "properties": {
          "role": {
            "$ref": "common.schema.json#/$defs/label"
          },
          "user_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "captured",
        "approved",
        "superseded"
      ]
    },
    "lineage": {
      "$ref": "common.schema.json#/$defs/lineage",
      "description": "Lineage for the values in this record (03-PRODUCTION-CONTRACTS: Evidence and fidelity)."
    }
  },
  "additionalProperties": false,
  "x-version": "0.1.0",
  "x-status": "draft",
  "x-source": [
    "03-PRODUCTION-CONTRACTS: Minimum schema set",
    "04-CLAUDE-CODE-BUILD-PROMPT §23",
    "01-PRODUCT-REQUIREMENTS §16",
    "05-PROJECT-PLAN M8B"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md"
}
