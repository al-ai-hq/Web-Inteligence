{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:brand-terms:0.1.0",
  "title": "BrandTerms",
  "description": "Owner-confirmed brand-term list (Arabic and English names, misspellings, transliterations) that splits every query report into brand and non-brand.",
  "type": "object",
  "required": [
    "brand_terms_id",
    "project_id",
    "version",
    "terms",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "brand_terms_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "language",
          "kind"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "language": {
            "$ref": "common.schema.json#/$defs/language"
          },
          "kind": {
            "type": "string",
            "enum": [
              "brand_name",
              "product_name",
              "misspelling",
              "transliteration",
              "abbreviation",
              "domain"
            ]
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 500
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "confirmed",
        "superseded"
      ]
    },
    "confirmed_by_user_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid",
          "description": "Project owner."
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmed_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "confirmed_by_user_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "confirmed_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          }
        }
      }
    }
  ],
  "x-version": "0.1.0",
  "x-status": "proposed",
  "x-source": [
    "02-DETAILED-SPECIFICATION §7, §16",
    "03-PRODUCTION-CONTRACTS: Required configuration"
  ],
  "x-source-fields": [
    "terms",
    "confirmed_by_user_id"
  ],
  "x-added-fields": [
    "brand_terms_id",
    "project_id",
    "version",
    "status",
    "confirmed_at",
    "created_at",
    "updated_at"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md"
}
