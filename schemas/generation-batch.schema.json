{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wpi:schema:generation-batch:0.1.0",
  "title": "GenerationBatch",
  "description": "A small approved batch of programmatic pages with canary and QA sample. The governor can stop a batch; it cannot publish one. Publishing goes through the change workflow.",
  "type": "object",
  "required": [
    "batch_id",
    "template_id",
    "record_ids",
    "canary",
    "qa_sample_size",
    "status",
    "created_at"
  ],
  "properties": {
    "batch_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "template_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "record_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      },
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "description": "ASSUMPTION: 500 records per batch maximum."
    },
    "canary": {
      "type": "boolean"
    },
    "qa_sample_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "approval_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "change_set_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "approved",
        "generating",
        "qa_review",
        "stopped",
        "handed_to_change_workflow",
        "completed"
      ]
    },
    "stop_reason_key": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/message_key"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved",
              "generating",
              "qa_review",
              "handed_to_change_workflow",
              "completed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approval_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "stopped"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "stop_reason_key": {
            "$ref": "common.schema.json#/$defs/message_key"
          }
        }
      }
    }
  ],
  "x-version": "0.1.0",
  "x-status": "draft",
  "x-source": [
    "03-PRODUCTION-CONTRACTS: Minimum schema set",
    "01-PRODUCT-REQUIREMENTS §17",
    "04-CLAUDE-CODE-BUILD-PROMPT §25"
  ],
  "x-migration": "additive optional fields bump minor; removals, renames or type changes bump major and need a migration note in docs/decisions.md"
}
